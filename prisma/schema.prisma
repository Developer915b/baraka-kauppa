generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameEn    String
  nameFi    String
  descEn    String
  descFi    String
  price     Float
  unit      String
  category  String
  image     String
  badge     String?
  stock     Int      @default(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category])
}

model Order {
  id          Int      @id @default(autoincrement())
  orderNo     String   @unique
  customerName String
  phone       String
  email       String?
  address     String?
  city        String?
  postalCode  String?
  method      String // "delivery" | "pickup"
  notes       String?
  subtotal    Float
  deliveryFee Float
  total       Float
  items       String // JSON string of OrderItem[]
  status      String   @default("new")
  createdAt   DateTime @default(now())
}
